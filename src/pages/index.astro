---
export const prerender = true;
import Dashboard from '../components/Dashboard';
---

<!doctype html>
<html lang="en" class="bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>US Presidential Pardons · Data Visualization</title>
    <meta name="description" content="Interactive visualization of US presidential clemency grants — pardons and commutations by Trump (2nd term) and Biden." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', system-ui, sans-serif; }
      :root { font-feature-settings: "tnum" on, "lnum" on; }
    </style>
  </head>
  <body class="min-h-screen bg-slate-900 text-slate-100">
    <header class="sticky top-0 z-10 border-b border-white/[0.06] bg-slate-900/90 backdrop-blur-md">
      <div class="h-[2px] bg-gradient-to-r from-red-500 via-indigo-500 to-blue-500"></div>
      <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <div class="flex items-baseline gap-3">
              <h1 class="text-xl font-bold tracking-tight text-white">US Presidential Pardons</h1>
              <span class="hidden text-xs font-medium text-slate-500 sm:inline">1993 – 2025</span>
            </div>
            <p class="mt-0.5 text-xs text-slate-500">
              Data via <a href="https://pardonned.com" class="text-slate-400 underline underline-offset-2 decoration-slate-600 hover:text-white transition-colors" target="_blank" rel="noopener">pardonned.com</a> · US Department of Justice
            </p>
          </div>
          <a
            href="https://github.com/huanglizhuo/pardonned-chart"
            target="_blank"
            rel="noopener"
            aria-label="View source on GitHub"
            class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-300 transition-all hover:border-white/20 hover:bg-white/10 hover:text-white"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            Source
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <Dashboard client:load />
    </main>

    <footer class="mt-16 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
      Data via <a href="https://pardonned.com" class="hover:text-slate-300" target="_blank" rel="noopener">pardonned.com</a>
      · Source: US Department of Justice Office of the Pardon Attorney
    </footer>
  </body>
</html>
